# Copy to .env and fill in. Every variable this project defines is
# BRAIN_-prefixed (ADR-0000 rule 3). The exceptions are at the bottom: API key
# names owned by the provider SDKs, which read them themselves.

# WebSocket listener the brain binds. Bodies dial in; the brain never dials out.
# The port is arbitrary and deliberately config, not protocol: SPEC says the
# brain URL is body-side config and names no port. Body-side config always wins.
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8765

# Shared secret a body presents in `hello`. Compared in constant time.
BRAIN_AUTH_TOKEN=

# Directory for MCAP flight-recorder sessions.
BRAIN_LOG_DIR=./var/logs

# Override the protocol schema location. Leave unset when running from a
# checkout: the loader walks up and finds protocol/schemas/protocol.schema.json
# on its own. Needed only when the package is installed away from that tree.
# BRAIN_PROTOCOL_SCHEMA=

# --- Body-side, read by an adapter process, not by the brain ---
# The brain URL is body-side config and the brain never dials out, so this
# lives with the body (SPEC section 3.1). BRAIN_AUTH_TOKEN above is shared:
# the body presents it, the brain compares it.
BRAIN_URL=ws://127.0.0.1:8765
BRAIN_BODY_ID=mock-01
BRAIN_LOG_LEVEL=INFO

# --- LLM routing (ADR-0007) ---
# One variable per role, each holding `provider:model`. Providers: anthropic,
# openai, google, ollama, stub. A role left unset has no model behind it and
# raises when something asks for it, which is deliberate: ADR-0007 point 3
# makes the eval harness the only authority on which model serves which role,
# so shipping defaults here would pre-empt it. Step 5.2 fills these in.
# BRAIN_LLM_PLANNER=
# BRAIN_LLM_CONVERSATION=
# BRAIN_LLM_VISION=
# BRAIN_LLM_CLASSIFIER=
# BRAIN_LLM_REFLEX=

# Where the local Ollama daemon listens. Unset uses the SDK's own default.
# BRAIN_OLLAMA_HOST=

# --- Provider keys, read by the SDKs themselves ---
# Not BRAIN_-prefixed because these names belong to the vendors, not to this
# project. Only needed for the providers actually routed to above; the default
# install and CI need none of them, which is why the SDKs are optional extras
# (uv sync --extra llm).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
