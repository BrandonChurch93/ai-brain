# Copy to .env and fill in. Every variable in this project is BRAIN_-prefixed
# (ADR-0000 rule 3). Provider-owned key names arrive with the LLM layer in
# Phase 5 and are documented there.

# WebSocket listener the brain binds. Bodies dial in; the brain never dials out.
# The port is arbitrary and deliberately config, not protocol: SPEC says the
# brain URL is body-side config and names no port. Body-side config always wins.
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8765

# Shared secret a body presents in `hello`. Compared in constant time.
BRAIN_AUTH_TOKEN=

# Directory for MCAP flight-recorder sessions.
BRAIN_LOG_DIR=./var/logs

# Override the protocol schema location. Leave unset when running from a
# checkout: the loader walks up and finds protocol/schemas/protocol.schema.json
# on its own. Needed only when the package is installed away from that tree.
# BRAIN_PROTOCOL_SCHEMA=
