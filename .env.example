# Copy to .env and fill in. Every variable in this project is BRAIN_-prefixed
# (ADR-0000 rule 3). Provider-owned key names arrive with the LLM layer in
# Phase 5 and are documented there.

# WebSocket listener the brain binds. Bodies dial in; the brain never dials out.
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8765

# Shared secret a body presents in `hello`. Compared in constant time.
BRAIN_AUTH_TOKEN=

# Directory for MCAP flight-recorder sessions.
BRAIN_LOG_DIR=./var/logs
