#!/usr/bin/env bash
# Gate 3 drill: the socket dies mid-mission and the body fails safe.
# One command, no arguments. See scripts/gate3_drill.py for what to expect.
set -euo pipefail

cd "$(dirname "$0")/.."

# PYTHONPATH is set here rather than relying on the editable install: on
# macOS uv writes its .pth with the UF_HIDDEN flag and CPython's site module
# silently skips hidden .pth files, so src/ never reaches sys.path.
export PYTHONPATH=src

exec uv run python scripts/gate3_drill.py "$@"
